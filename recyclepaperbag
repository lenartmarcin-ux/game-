#import pgzrun
import random

HEIGHT = 600
WIDTH = 800

# player 
bin= Actor("bin",(400, 500))
# objects
paper=Actor("paperbag",(random.randint(50,750),0))
plastic=Actor("plasticbag",(random.randint(50,750),-200))

score=0
lives=3
time=30

game_over=False

def countdown():
    global time, game_over
    if time > 0:
        time -= 1
    else:
        game_over = True

clock.schedule_interval(countdown, 1.0)

def on_mouse_move(pos):
    bin.x = pos[0]
    if bin.left < 0:
        bin.left = 0
    if bin.right > WIDTH: 
        bin.right = WIDTH

def update():
    global score, lives, game_over
    if not game_over:
        paper.y += 5
        plastic.y += 5

        if paper.top > HEIGHT:
            paper.x = random.randint(50, 750)
            paper.y = 0
            lives -= 1

        if plastic.top > HEIGHT:
            plastic.x = random.randint(50, 750)
            plastic.y = -200
            lives -= 1

        if bin.colliderect(paper):
            score += 1
            paper.x = random.randint(50, 750)
            paper.y = 0

        if bin.colliderect(plastic):
            lives -= 1
            plastic.x = random.randint(50, 750)
            plastic.y = -200

        if lives <= 0:
            game_over = True

def draw():
    screen.clear()
    screen.fill("white")
    if not game_over:
        bin.draw()
        paper.draw()
        plastic.draw()
        screen.draw.text("Score: " + str(score), (10, 10), fontsize=30, color="black")
        screen.draw.text("Lives: " + str(lives), (10, 50), fontsize=30, color="black")
        screen.draw.text("Time: " + str(time), (10, 90), fontsize=30, color="black")
    else:
        screen.fill("black")
        screen.draw.text("Game Over", center=(WIDTH/2, HEIGHT/2), fontsize=60, color="red")
        screen.draw.text("Final Score: " + str(score), center=(WIDTH/2, HEIGHT/2 + 60), fontsize=40, color="white")

pgzrun.go()
