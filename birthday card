import pygame
import time
import random

pygame.init()
font = pygame.font.SysFont(None, 35)
small_font = pygame.font.SysFont("arial", 35)
screen = pygame.display.set_mode((600, 500))
pygame.display.set_caption("Birthday present")
start_time = time.time()

balloon_x = random.randint(50, 550)
balloon_y = 500
balloon_speed = 2
balloon_colour = random.choice(["red", "pink", "blue", "purple", "yellow"])

page = 1
running = True
clock = pygame.time.Clock()

while running:
    screen.fill("black")

    current_time = time.time() - start_time

    if current_time > 3:
        page = 2

    balloon_y -= balloon_speed

    if balloon_y < -60:
        balloon_y = 500
        balloon_x = random.randint(50, 550)
        balloon_colour = random.choice(["red", "pink", "blue", "purple", "yellow"])

    pygame.draw.ellipse(screen, balloon_colour, (balloon_x - 20, balloon_y - 30, 40, 50))

    pygame.draw.line(screen, "white", (balloon_x, balloon_y + 20), (balloon_x, balloon_y + 65), 2)

    if page == 1:
        text = font.render("Happy Birthday", True, "black")
        screen.blit(text, (120, 175))

        message = small_font.render("Have a wonderful day", True, "black")
        screen.blit(message, (150, 250))

    else:
        text = font.render("HAPPY BIRTHDAY!", True, "blue")
        screen.blit(text, (100, 150))

        message = small_font.render("Wishing you lots of happiness!", True, "purple")
        screen.blit(message, (60, 250))

        message2 = small_font.render("Enjoy your special day!", True, "red")
        screen.blit(message2, (100, 320))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    pygame.display.update()
    clock.tick(60)

pygame.quit()
