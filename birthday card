import pygame 
import time
import random

pygame.init()
font = pygame.font.SysFont(None, 35)
small_font = pygame.font.SysFont("arial", 35)
screen = pygame.display.set_mode((600, 500))
pygame.display.set_caption("Birhtday present")
start_time = time.time()

page = 1 
running = True

while running:
    screen.fill("black")
    current_time = time.time()-start_time
    if current_time > 3:
        page = 2
    if page == 1:
        text = font.render("Happy Birthday", True, "black")
        screen.blit(text, (120, 175))

        message = small_font.render("Have a wonderful day", True, "black")
        screen.blit(message, (150, 250))
    else:
        text = font.render("HAPPY BIRTHDAY!", True, "blue")
        screen.blit(text, (100, 150))

        message = small_font.render("Wishing you lots of happiness!", True, "purple")
        screen.blit(message, (60, 250))

        message2 = small_font.render("Enjoy your special day!", True, "red")
        screen.blit(message2, (100, 320))
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
    pygame.display.update()

pygame.quit()
